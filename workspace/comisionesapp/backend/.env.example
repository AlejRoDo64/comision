# ── App ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Fuentes de datos (por origen: real | mock) ────────────────────────
# mock: datos de prueba desde Datatest/ (desarrollo sin acceso a la red)
# real: conexión oficial (requiere credenciales abajo)
# Si no se definen, ambas heredan de FUENTES_MODO; default: real.
MIDASOFT_MODO=real
INDICADORES_MODO=real
# FUENTES_MODO=real
# Opcional: ruta a la carpeta Datatest si no está en la raíz del repo
# DATATEST_DIR=
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Obligatorio: la app NO arranca sin JWT_SECRET
JWT_SECRET=cambiar-en-cada-ambiente

# Usuarios semilla del repositorio mock (solo desarrollo; se retiran con la BD real)
SEED_ADMIN_PASSWORD=
SEED_COMISIONES_PASSWORD=

# ── BD propia de la aplicación (SQL Server 2022 — pendiente de asignación) ──
# DB_HOST=localhost
# DB_PORT=1433
# DB_USERNAME=
# DB_PASSWORD=
# DB_DATABASE=comisiones

# ── INDICADORES — ventas ICG (SOLO LECTURA) ───────────────────────────
INDICADORES_HOST=10.1.5.61
INDICADORES_PORT=1433
INDICADORES_DB=INDICADORES
INDICADORES_USER=LecturaBd
INDICADORES_PASSWORD=

# ── API Midasoft (ambiente pruebas — SOLO CONSULTA) ───────────────────
MIDASOFT_BASE_URL=https://pruebaspermoda.midasoft.co/APIS/Midas_APIS/api
MIDASOFT_COMPANY_ID=
MIDASOFT_USERNAME=COMISIONES
MIDASOFT_PASSWORD=
