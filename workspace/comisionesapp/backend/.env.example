# ── General ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── JWT ──────────────────────────────────────────────────────────────
JWT_SECRET=cambia_este_valor_por_uno_seguro_en_produccion
JWT_EXPIRES_IN=8h

# ── Base de datos — Target canónico: SQL Server 2022 ─────────────────
DB_TYPE=mssql
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=TuPasswordSeguro
DB_DATABASE=permoda_comisiones

# ── Base de datos — Pruebas locales con MySQL Workbench ──────────────
# Cambia los valores anteriores por los de abajo para testing local.
# NO usar DB_TYPE=mysql en producción — solo SQL Server está aprobado.
# DB_TYPE=mysql
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=TuPasswordLocal
